body {
  margin: 0;
  font-family: 'Inter', sans-serif;
  background: #f3f6fa;
  color: #0f172a;
}

.main-header {
  background: #0f172a;
  color: #fff;
  padding: 16px 24px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.main-header nav a {
  margin-left: 16px;
  color: #fff;
  text-decoration: none;
  font-weight: 500;
}

.main-header nav a.active {
  text-decoration: underline;
}

.btn {
  background: #0073ff;
  padding: 10px 14px;
  border-radius: 8px;
  border: none;
  color: #fff;
  cursor: pointer;
  font-weight: 600;
}

.btn-logout {
  background: #ef4444;
  padding: 10px 16px;
  border: none;
  border-radius: 6px;
  color: #fff;
  font-weight: 600;
  cursor: pointer;
}

.container {
  max-width: 1100px;
  margin: 40px auto;
  padding: 0 20px;
}

.stats-grid, .action-grid, .form-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 16px;
}

.stat-card, .action-card {
  background: #fff;
  padding: 16px;
  border-radius: 12px;
  box-shadow: 0 4px 10px rgba(0,0,0,0.05);
  border: 1px solid rgba(0,0,0,0.08);
}

.chat-box {
  height: 500px;
  background: #fff;
  padding: 16px;
  border-radius: 12px;
  overflow-y: auto;
}

.chat-input {
  display: flex;
  margin-top: 20px;
}

.chat-input input {
  flex: 1;
  padding: 10px;
  border-radius: 8px;
  border: 1px solid #cbd5e1;
}

.chat-input button {
  margin-left: 10px;
}
